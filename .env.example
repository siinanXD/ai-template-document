# API
DATABASE_URL=postgresql+psycopg://starter:starter@localhost:5434/starter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
# Optional. Cost stays unknown unless both prices are set (USD per 1M tokens).
# OPENAI_INPUT_USD_PER_MTOK=0.15
# OPENAI_OUTPUT_USD_PER_MTOK=0.60
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=1048576
MAX_EXTRACT_CHARS=20000
REVIEW_CONFIDENCE_THRESHOLD=0.75

# Optional Langfuse. The app runs without these.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# Compose host port. 5434 avoids colliding with ai-starter / ai-template-rag on 5432.
# POSTGRES_PORT=5434

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
